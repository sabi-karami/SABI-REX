# ===== SABI-REX =====
# REX_PANEL_KEY=           # secret entrance key (16-64 letters/digits). Panel opens ONLY at https://DOMAIN/<key>
# REX_INIT_PASSWORD=       # first-install admin password (10+ chars). Empty = random, printed once in the deploy log
# PANEL_DOMAIN=            # e.g. sabirex.example.com (custom domain used in all configs)
PORT=8080
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8000
XRAY_JSON=/var/lib/marzban/xray_config.json
SQLALCHEMY_DATABASE_URL=sqlite:////var/lib/marzban/db.sqlite3
# --- optional (remove the # and fill in) ---
# DOCTOR_TG_TOKEN=123456:ABC...        support bot alerts (panel + reseller panels)
# DOCTOR_TG_CHAT=123456789             your numeric Telegram id
# TELEGRAM_API_TOKEN=123456:ABC...     Marzban's own Telegram bot (manage users from Telegram)
# TELEGRAM_ADMIN_ID=123456789
# CF_TUNNEL_TOKEN=                     Cloudflare tunnel (low ping)
# CF_TUNNEL_HOSTNAME=
# CF_CLEAN_IP=
# IRAN_RELAY_IP=                       Iranian relay server (lowest ping), see iran-relay.sh
# --- speed / stability knobs (all already ON by default, set to 0 only to turn one off) ---
# REX_MUX=1                           Mux on (off by default: Hiddify / sing-box / Clash cannot use it with Xray)
# REX_XHTTP=0                         XHTTP off (on by default: Warp Speed = packet-up, Quantum = stream-up; off = both move to HTTPUpgrade)
# REX_TFO=1                           TCP Fast Open on (off by default)
# USE_CUSTOM_JSON_FOR_V2RAYNG=True      full JSON configs for v2rayNG (default: plain links, like SABI-REX)
# REX_PATH_SECRET=MyPanel-2026        your own secret config path id (8-64 letters/digits/-), default = random, kept forever
# REX_OLD_PATHS=0                     close the old paths of v12 (/panel-ws, /vless ...) after everyone updated the sub
# REX_HEARTBEAT=0                     WS keep-alive ping off (number = seconds, default 30)
# REX_BBR=0                           BBR off
# REX_ADBLOCK=0                       ad blocker off
# REX_FRAGMENT=                       empty = no fragment routes
# REX_EXTRA_DOMAINS=a.up.railway.app  more Railway domains of this service = Mirror configs
# REX_REALITY_SNI=www.speedtest.net   Reality camouflage site (TCP Proxy only)
